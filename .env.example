# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NEXUS
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft / Entra ID / Graph
# Prefer "organizations" for enterprise work/school accounts. Use a fixed Entra tenant id
# for a single-tenant deployment. Avoid "common" unless you intentionally support
# broader Microsoft account discovery and still enforce NEXUS tenant mapping server-side.
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
MICROSOFT_GRAPH_SCOPES=openid profile email offline_access User.Read Mail.Read
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_OUTLOOK_ADDIN_ENABLED=false
